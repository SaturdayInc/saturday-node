{
  "name": "@saturdayinc/sdk",
  "version": "0.9.0",
  "description": "Official TypeScript SDK for the Saturday Nutrition Intelligence API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.mts",
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "esm"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "keywords": [
    "saturday",
    "nutrition",
    "endurance",
    "hydration",
    "electrolytes",
    "sports-nutrition",
    "api"
  ],
  "author": "Saturday Inc. <api@saturday.fit>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaturdayInc/saturday-node.git"
  },
  "homepage": "https://docs.saturday.fit",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "20.19.39",
    "jest": "29.7.0",
    "@types/jest": "29.5.14",
    "ts-jest": "29.4.9"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "test/tsconfig.json"
        }
      ]
    }
  }
}
